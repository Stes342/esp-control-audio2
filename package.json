{
  "name": "PowerControl",
  "version": "1.0.0",
  "description": "Power Control Application",   
  "author": "Roman Stebletzov",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"npm:dev\" \"npm:electron\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.example.esp",
    "productName": "Power Control",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": "nsis"
    }
  },
  "dependencies": {
    "axios": "^1.10.0",    
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^9.2.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.14.1"
  }
}
